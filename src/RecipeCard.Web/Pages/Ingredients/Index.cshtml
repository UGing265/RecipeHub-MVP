@page
@model RecipeCard.Web.Pages.Ingredients.IndexModel
@{
    ViewData["Title"] = "Danh mục nguyên liệu";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <div class="text-uppercase text-muted fw-semibold" style="font-size: 12px; letter-spacing: 0.05em;">Dữ liệu R&D</div>
        <h2 class="fw-bold mb-0">Danh mục nguyên liệu</h2>
    </div>
    <a asp-page="./Create" class="btn-mobbin-primary">
        <span>+ Thêm nguyên liệu</span>
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="p-3 mb-4 rounded-pill d-flex align-items-center justify-content-between" 
         style="background-color: #fff2f2; border: 1px solid #ffd0d0; color: #b71c1c; font-size: 14px;">
        <div class="d-flex align-items-center gap-2">
            <span class="fw-bold">●</span>
            <span>@Model.ErrorMessage</span>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="p-3 mb-4 rounded-pill d-flex align-items-center justify-content-between" 
         style="background-color: var(--color-canvas-soft); border: 1px solid var(--color-hairline); color: var(--color-ink); font-size: 14px;">
        <div class="d-flex align-items-center gap-2">
            <span class="text-success fw-bold">✓</span>
            <span>@Model.SuccessMessage</span>
        </div>
    </div>
}

@if (Model.Ingredients.Count == 0)
{
    <div class="mobbin-card text-center py-5">
        <div class="text-muted mb-3" style="font-size: 15px;">Chưa có nguyên liệu nào trong kho dữ liệu.</div>
        <a asp-page="./Create" class="btn-mobbin-primary">Thêm nguyên liệu đầu tiên</a>
    </div>
}
else
{
    <div class="mobbin-table-container">
        <table class="mobbin-table">
            <thead>
                <tr>
                    <th style="width: 80px;">STT</th>
                    <th>Tên nguyên liệu</th>
                    <th style="width: 200px;">Đơn vị mặc định</th>
                    <th style="width: 180px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in Model.Ingredients)
                {
                    <tr>
                        <td class="text-muted" style="font-size: 13px;">@(stt++)</td>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <span class="badge-pill-soft">@item.DefaultUnit</span>
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                <a asp-page="./Edit" asp-route-id="@item.Id" class="btn-mobbin-soft btn-mobbin-sm">Sửa</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nguyên liệu này?');">
                                    <button type="submit" class="btn-mobbin-danger">Xóa</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
